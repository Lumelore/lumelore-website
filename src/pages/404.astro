---
import '../styles/global.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<title>404</title>
        <style>

            body {
                display: flex;
                flex-direction: column;
                align-items: center;

                margin: 8rem 1rem 8rem 1rem;
                padding: 0;
                font-family: "DejaVu Sans", sans-serif;
                color: #f6f4e6;

                background: #5b4a75;
                
            }

            .error-msg-border {
                border-radius: 2.25rem;
                background: linear-gradient(200deg, #97d442, #ad2860);
            }

            .main-error {
                display: flex;
                flex-direction: row;
                flex-wrap: nowrap;
                align-items: stretch;
                gap: 0.5rem;
                
                margin: 0.25rem;
                padding: 2rem;

                background: #8972a1;
                border-radius: 2rem;
            }

            img {
                padding: 0;
                margin: 0;
                align-self: center;
            }

            .error-text {
                display: flex;
                flex-direction: column;
                align-items: start;
            }

            p {
                margin: 0;
            }

        </style>
	</head>
	<body>
        <div class="error-msg-border">
            <div class="main-error">

                <img src="/faces/pixel-dragon-right.svg" width="120" height="120" />

                <div class="error-text">
                    <h1>404</h1>
                    <p>The page you requested can't be found</p>
                </div>
                
            </div>
        </div>
	</body>
</html>