---
interface Props {
    error: unknown;
}

const { error } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<title>500 Error</title>
        <style>
            body {
                display: flex;
                flex-direction: column;
                align-items: center;
            }
            #error-msg {
                display: flex;
                flex-direction: column;
                align-items: center;
            }

        </style>
	</head>
	<body>
		<h1>Oopsie Whoopsie! I made a fucky wucky!</h1>
        <p> Please forgive me uwu</p>
		<img src="/faces/pixel-dragon-blush.svg" width="120" height="120" />
        <div id="error-msg">{error instanceof Error ? error.message : (<p>Unknown error</p> <small>(or perhaps there is no error and you purposely went here?)</small>)}</div>
	</body>
</html>
