---
import '../styles/single-page/mods.css';
import ThemedLayout from '../layouts/ThemedLayout.astro';
import ModListing from '../components/mods/ModListing.astro';
---

<ThemedLayout title="Mods">
    <h1 style="margin-left:auto; margin-right:auto;">Mods</h1>
    <section>
		<a class="tag-link" href="#minecraft"><h2>Minecraft</h2></a>
		<hr/>

        <ModListing
            thumb="/mods/gaht-mod/gaht_mod_icon.png"
            modName="GAHT Mod"
            ver="1.21"
            desc="The GAHT (Gender Affirming Hormone Therapy) mod adds GAHT to Minecraft in the form of new items and effects. These effects are: Girl Power, Boy Power, and Enby Power. As a Celeste reference, these allow you to air dash, except for enby power, which lets you slide up walls instead."
            link="/mods/mc-gaht-mod"
        />
    </section>
</ThemedLayout>