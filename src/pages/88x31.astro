            <Button88x31 src="/88x31/lyra.horse.png" link="https://lyra.horse"/>
            <Button88x31 src="/88x31/melonking.net.png" link="https://melonking.net"/>
            <Button88x31 src="/88x31/mesoscale.neocities.org.gif" link="https://mesoscale.neocities.org"/>
            <Button88x31 src="/88x31/mooeena.neocities.org.png" link="https://mooeena.neocities.org"/>
            <Button88x31 src="/88x31/ninacti0n.art.gif" link="https://ninacti0n.art"/>
            <Button88x31 src="/88x31/pupbeedog.world.png" link="https://pupbeedog.world"/>
            <Button88x31 src="/88x31/ribboncable.net.gif" link="https://ribboncable.net"/>
            <Button88x31 src="/88x31/saltedslug.net.png" link="https://saltedslug.net"/>
            <Button88x31 src="/88x31/solaria.neocities.org.png" link="https://solaria.neocities.org"/>
            <Button88x31 src="/88x31/spiritcellar.neocities.org.gif" link="https://spiritcellar.neocities.org"/>
            <Button88x31 src="/88x31/starrs.neocities.org.gif" link="https://starrs.neocities.org"/>
            <Button88x31 src="/88x31/starry-knight.neocities.org.png" link="https://starry-knight.neocities.org"/>
            <Button88x31 src="/88x31/sweetfish.site.png" link="https://sweetfish.site"/>
            <Button88x31 src="/88x31/warp.zone.gif" link="https://warp.zone"/>
