---
import '../styles/global.css';
import '../styles/themed-style.css';

import '@fontsource/opendyslexic';
import '@fontsource/dejavu-sans';

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
		<script src="../scripts/save-theme.ts" />
		<script src="../scripts/block-css-transitions-on-load.ts" />
		<title>{title}</title>
	</head>
	<body>

		<div class="primary">

			<aside>
				<form class="theme-selector">
					<fieldset>
						<legend>Theme</legend>
						
						<label for="spacetiles">
							<div class="label-content">
								<img src="/backgrounds/icon/SpaceTile.png" height="64" width="64" />
								<span class="theme-option-name">Nebula Bricks</span>
								<input type="radio" name="theme-option" id="spacetiles" checked>
							</div>
						</label>

						<label for="queertiles">
							<div class="label-content">
								<img src="/backgrounds/icon/QueerTile.png" height="64" width="64" />
								<span class="theme-option-name">Queer Cubes</span>
								<input type="radio" name="theme-option" id="queertiles">
							</div>
						</label>

						<label for="testtiles">
							<div class="label-content">
								<img src="/backgrounds/icon/QueerTile.png" height="64" width="64" />
								<span class="theme-option-name">Test Tiles</span>
								<input type="radio" name="theme-option" id="testtiles">
							</div>
						</label>

					</fieldset>
				</form>

				<nav>
					<h3>Links</h3>

					<div class="nav-links">
						<a href="/">Home</a>
						<a href="/testing">Testing</a>
						<a href="/blog/testblog">Testing Blog</a>
					</div>
				</nav>
			</aside>

			<main>
				<slot />
			</main>

			<div class="side-margin" />

		</div>

	</body>
</html>