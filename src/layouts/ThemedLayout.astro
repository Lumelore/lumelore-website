---
import '../styles/global.css';
import '../styles/themed-style.css';
import '../styles/themed-style-icons.css';

import '@fontsource/opendyslexic';
import '@fontsource/dejavu-sans';

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
		<script src="../scripts/save-theme.ts" />
		<script src="../scripts/block-css-transitions-on-load.ts" />
		<title>{title}</title>
	</head>
	<body>

		<div class="primary">

			<aside>

				<!-- This is for a checkbox that hides/shows the side menu for mobile users -->
				<label class="aside-menu-toggler" for="aside-toggle">
					<div>✶ Menu ✶</div>
					<input type="checkbox" id="aside-toggle" checked>
				</label>

				<div class="aside-menu-items">

					<form class="panel-container">
						<fieldset class="panel-list">
							<legend class="panel-title">Theme</legend>
							
							<label for="spacetiles" class="panel-li">
								<div class="panel-li-background" />
								<div class="panel-li-img-container">
									<img src="/theme/space/SpaceTile.png" height="64" width="64" />
								</div>
								<div class="panel-li-name">Nebula Bricks</div>
								<div class="panel-li-overlay" />
								<input type="radio" name="theme-option" id="spacetiles" checked>
							</label>

							<label for="queertiles" class="panel-li">
								<div class="panel-li-background" />
								<div class="panel-li-img-container">
									<img src="/theme/queer/QueerTile.png" height="64" width="64" />
								</div>
								<div class="panel-li-name">Queer Cubes</div>
								<div class="panel-li-overlay" />
								<input type="radio" name="theme-option" id="queertiles">
							</label>

							<label for="frutigeraero" class="panel-li">
								<div class="panel-li-background" />
								<div class="panel-li-img-container">
									<img src="/theme/queer/QueerTile.png" height="64" width="64" />
								</div>
								<div class="panel-li-name">Frutiger Aero</div>
								<div class="panel-li-overlay" />
								<input type="radio" name="theme-option" id="frutigeraero">
							</label>
						</fieldset>
					</form>

					<nav class="panel-container">
						<h3 class="panel-title">Links</h3>

						<div class="panel-list">
							<a href="/" class="panel-li" id="index">
									<div class="panel-li-background" />
									<div class="panel-li-img-container">
										<img class="smooth-img" id="index-icon" src="/theme/space/icon/home.png" height="64" width="64" />
									</div>
									<div class="panel-li-name">Home</div>
									<div class="panel-li-overlay" />
							</a>
							<a href="/games" class="panel-li" id="games">
									<div class="panel-li-background" />
									<div class="panel-li-img-container">
										<img class="smooth-img" id="games-icon" src="/theme/space/icon/games.png" height="64" width="64" />
									</div>
									<div class="panel-li-name">Games</div>
									<div class="panel-li-overlay" />
							</a>
							<a href="/mods" class="panel-li" id="mods">
									<div class="panel-li-background" />
									<div class="panel-li-img-container">
										<img class="smooth-img" id="mods-icon" src="/theme/space/icon/mods.png" height="64" width="64" />
									</div>
									<div class="panel-li-name">Mods</div>
									<div class="panel-li-overlay" />
							</a>
							<a href="/blog" class="panel-li" id="blog">
									<div class="panel-li-background" />
									<div class="panel-li-img-container">
										<img class="smooth-img" id="blog-icon" src="/theme/space/icon/blog.png" height="64" width="64" />
									</div>
									<div class="panel-li-name">Blog</div>
									<div class="panel-li-overlay" />
							</a>
							<a href="/88x31" class="panel-li" id="pxbtn">
									<div class="panel-li-background" />
									<div class="panel-li-img-container">
										<img class="smooth-img" id="pxbtn-icon" src="/theme/space/icon/88x31.png" height="64" width="64" />
									</div>
									<div class="panel-li-name">88x31</div>
									<div class="panel-li-overlay" />
							</a>
						</div>
					</nav>
					
					<!-- Social links -->
					<div class="panel-container">
						<h3 class="panel-title">Socials</h3>

						<div class="panel-list">
							<a class="panel-li" href="https://www.youtube.com/@Lumelore" target="_blank" rel="noreferrer">
								<div class="panel-li-background" />
								<div class="panel-li-img-container">
									<img class="smooth-img" id="videos-icon" src="/theme/space/icon/videos.png" height="64" width="64" decoding=async />
								</div>
								<div class="panel-li-name">Youtube</div>
								<div class="panel-li-overlay" />
							</a>
							<a class="panel-li" href="https://lemmy.blahaj.zone/u/Lumelore" target="_blank" rel="noreferrer">
								<div class="panel-li-background" />
								<div class="panel-li-img-container">
									<img class="smooth-img" id="lemmy-blahaj-icon" src="/theme/space/icon/lemmy-blahaj.png" height="64" width="64" decoding=async />
								</div>
								<div class="panel-li-name">Lemmy</div>
								<div class="panel-li-overlay" />
							</a>
							<a class="panel-li" href="https://lumelore.itch.io/" target="_blank" rel="noreferrer">
								<div class="panel-li-background" />
								<div class="panel-li-img-container">
									<img class="smooth-img" id="itchio-icon" src="/theme/space/icon/games.png" height="64" width="64" decoding=async />
								</div>
								<div class="panel-li-name">itch.io</div>
								<div class="panel-li-overlay" />
							</a>
							<a class="panel-li" href="https://github.com/Lumelore" target="_blank" rel="noreferrer">
								<div class="panel-li-background" />
								<div class="panel-li-img-container">
									<img class="smooth-img" id="code-icon" src="/theme/space/icon/code.png" height="64" width="64" decoding=async />
								</div>
								<div class="panel-li-name">Github</div>
								<div class="panel-li-overlay" />
							</a>
						</div>

					</div>

				</div>
			</aside>

			<main>
				<slot />
			</main>

			<div class="side-margin" />

		</div>

	</body>
</html>