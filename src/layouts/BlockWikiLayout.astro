---
import '../styles/global.css';
import '../styles/mods/block-theme.css';

interface Props {
    title: string;
	desc?: string;
}

const { title, desc="Lumelore's modding and indie web spot!" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, viewport-fit=cover" />
		<link rel="icon" type="image/x-icon" href="/favicon/favicon.ico" />
		<link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
		
		<script src="../scripts/save-theme.ts" />
		<script src="../scripts/save-font.ts" />
		<script src="../scripts/block-css-transitions-on-load.ts" />

		<title>{title}</title>

		<meta property="og:title" content={title} />
		<meta property="og:description" content={desc} />
		<meta property="og:image" content="https://lumelore.net/hotlinks/generic-thumb.png" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="512" />
		<meta property="og:image:height" content="512" />
		<meta property="og:image:alt" content="A green dragon with pink horns and blonde hair above the text Lumelore" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:site_name" content="Lumelore's domain" />
	</head>
	<body>

        <aside>
        </aside>

		<div class="main-container">
			<main>
				<slot />
			</main>
		</div>

    </body>
</html>